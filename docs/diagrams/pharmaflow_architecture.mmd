---
config:
  theme: base
  themeVariables:
    clusterBkg: "#f8fafc"
    clusterBorder: "#cbd5e1"
    lineColor: "#475569"
  flowchart:
    curve: linear
    nodeSpacing: 22
    rankSpacing: 32
    subGraphTitleMargin:
      top: 8
      bottom: 12
---
flowchart TB
  solver["2D DEM solver<br/>NumPy CPU · optional Taichi contacts"]
  trajectories["Stored DEM trajectories<br/>Particle states · time · outlet crossings"]

  %% Research data and training
  labels["Retrospective event labels<br/>Future frames confirm arch events"]
  splits["Grouped dataset splits<br/>Whole runs or physical configurations"]
  fit["ML training<br/>Preprocessing and weights fit per fold"]
  model["Frozen ML model<br/>Stored artifact from the training pipeline"]
  labels --> splits --> fit --> model

  %% Inference and replay
  features["Causal feature extraction<br/>Current state and trailing observations"]
  frames["Stored frame playback<br/>Positions · speeds · contacts"]
  ml["Frozen ML score<br/>Model or verified score cache"]
  rule["Physics rule score<br/>Fixed M4A rule"]
  monitor["Chronological monitor<br/>Warning episodes and observed discharge"]
  dashboard["Interactive dashboard"]

  solver --> trajectories
  trajectories -.-> labels
  trajectories --> features
  trajectories --> frames
  features --> splits
  model --> ml
  features --> ml --> monitor --> dashboard
  features --> rule --> monitor
  frames --> dashboard

  subgraph external["External data audit"]
    direction LR
    sources["Experimental sources<br/>Cornerstones · Delft · Yogi"]
    provenance["Provenance review<br/>Access · schema · units"]
    checks["Compatibility checks<br/>Geometry · measured quantities"]
    conclusion["Qualitative comparison<br/>Quantitative calibration unresolved"]
    sources --> provenance --> checks --> conclusion
  end
  %% Invisible layout constraint places the independent audit below the dashboard.
  dashboard ~~~ external

  classDef simulation fill:#e8f2ff,stroke:#3c75bc,color:#172b43;
  classDef research fill:#eef7eb,stroke:#54814a,color:#172b43;
  classDef artifact fill:#fff4dc,stroke:#ac731c,color:#172b43;
  classDef runtime fill:#f1edff,stroke:#7866aa,color:#172b43;
  classDef evidence fill:#f1f5f9,stroke:#64748b,color:#172b43;
  class solver,trajectories,frames simulation;
  class labels,splits,fit research;
  class model artifact;
  class features,ml,rule,monitor,dashboard runtime;
  class sources,provenance,checks,conclusion evidence;
  linkStyle 4 stroke:#b45309,stroke-dasharray:5 4;
